#!/usr/bin/env python3
"""Write a "fleet" agent preset into the dsh web profile.

The preset is derived from the installed dsh-web-app `standard` preset, so it
tracks dsh upgrades, with the official-CLI delegates switched on:

  subagent_codex        @deepseek-ai/dsh-subagent-codex   (Codex app-server)
  subagent_claude_code  @deepseek-ai/dsh-subagent-claude-code (Claude Agent SDK)
  subagent_agy          @orchestra-next/dsh-subagent-agy  (agy --print)

Each delegate drives the vendor's own CLI under its own login; no credential
is read or forwarded. Re-run after upgrading dsh. The block lives between
markers in ~/.dsh/profiles/<profile>/cordis.patch.yml and is replaced in place.

usage: dsh-fleet-preset [--profile web] [--agy-mode review|accept-edits|full] [--print]
"""
from __future__ import annotations

import argparse
import os
import shutil
import sys
from pathlib import Path

BEGIN = "# >>> fleet preset (generated by orchestra-next/scripts/dsh-fleet-preset; do not edit)"
END = "# <<< fleet preset"
DELEGATES = ("tool-subagent-codex", "tool-subagent-claude-code")


def standard_preset() -> Path:
    dsh = shutil.which("dsh")
    if not dsh:
        sys.exit("dsh-fleet-preset: dsh is not on PATH")
    package = Path(dsh).resolve().parent.parent  # .../@deepseek-ai/dsh/lib/bin.js -> .../dsh
    for candidate in (package / "node_modules/@deepseek-ai/dsh-web-app/presets/standard.patch.yml",
                      package.parent / "dsh-web-app/presets/standard.patch.yml"):
        if candidate.is_file():
            return candidate
    sys.exit(f"dsh-fleet-preset: cannot find dsh-web-app's standard preset near {package}")


def transform(text: str, agy_mode: str) -> str:
    lines = text.splitlines()
    out: list[str] = []
    seen = {"preset": False, "id": False, "order": False, "agy": False}
    skip_disabled_for: str | None = None
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("#") and not out:
            continue  # drop the shipped header comment
        if stripped == "- id: preset-standard":
            line = line.replace("preset-standard", "preset-fleet"); seen["preset"] = True
        elif stripped == "id: standard" and not seen["id"]:
            line = line.replace("standard", "fleet"); seen["id"] = True
        elif stripped.startswith("order:") and not seen["order"]:
            line = line[: len(line) - len(line.lstrip())] + "order: 0"; seen["order"] = True
        if stripped in (f"- id: {d}" for d in DELEGATES):
            skip_disabled_for = stripped
        elif skip_disabled_for and stripped == "disabled: true":
            skip_disabled_for = None
            continue
        elif stripped.startswith("- id:"):
            skip_disabled_for = None
        if stripped == "- id: workflow-ptc" and not seen["agy"]:
            indent = line[: len(line) - len(line.lstrip())]
            out += [
                f"{indent}- id: tool-subagent-agy",
                f"{indent}  name: '@deepseek-ai/dsh-tool-subagent'",
                f"{indent}  config:",
                f"{indent}    provider: agy",
                f"{indent}    toolName: subagent_agy",
                f"{indent}    backgroundMode: one-shot",
                f"{indent}    maxDepth: provider-managed",
            ]
            seen["agy"] = True
        out.append(line)
    missing = [k for k, v in seen.items() if not v]
    if missing:
        sys.exit(f"dsh-fleet-preset: the standard preset changed shape (missing {missing}); update this script")
    body = "\n".join(out)
    agy = ("- id: subagent-agy\n"
           "  config:\n"
           f"    mode: {agy_mode}\n")
    return f"{BEGIN}\n{agy}{body}\n{END}\n"


ROOT_ROWS = """- insert:
    - id: tool-subagent-codex
      name: '@deepseek-ai/dsh-tool-subagent'
      config: {provider: codex, toolName: subagent_codex, backgroundMode: one-shot, maxDepth: provider-managed}
    - id: tool-subagent-claude-code
      name: '@deepseek-ai/dsh-tool-subagent'
      config: {provider: claude-code, toolName: subagent_claude_code, backgroundMode: one-shot, maxDepth: provider-managed}
    - id: tool-subagent-agy
      name: '@deepseek-ai/dsh-tool-subagent'
      config: {provider: agy, toolName: subagent_agy, backgroundMode: one-shot, maxDepth: provider-managed}
"""


def root_block(agy_mode: str) -> str:
    """Profiles without agent presets (headless, sdk, acp) mount tools at the root."""
    return f"{BEGIN}\n- id: subagent-agy\n  config:\n    mode: {agy_mode}\n{ROOT_ROWS}{END}\n"


def uses_presets(profile: str) -> bool:
    import json
    home = Path(os.environ.get("DSH_HOME", "~/.dsh")).expanduser()
    try:
        bundles = json.loads((home / "profiles" / profile / "package.json").read_text())["dsh"]["profile"]["bundles"]
    except (OSError, ValueError, KeyError, TypeError):
        sys.exit(f"dsh-fleet-preset: cannot read the bundles of profile {profile!r}")
    return "@deepseek-ai/dsh-web-app" in bundles


def install(profile: str, block: str) -> Path:
    home = Path(os.environ.get("DSH_HOME", "~/.dsh")).expanduser()
    target = home / "profiles" / profile / "cordis.patch.yml"
    if not target.parent.is_dir():
        sys.exit(f"dsh-fleet-preset: no dsh profile at {target.parent}")
    current = target.read_text() if target.exists() else ""
    if BEGIN in current and END in current:
        head, rest = current.split(BEGIN, 1)
        tail = rest.split(END, 1)[1].lstrip("\n")
        updated = head + block + tail
    else:
        kept = [l for l in current.splitlines() if l.strip() not in ("[]",)]
        updated = ("\n".join(kept).rstrip() + "\n\n" if any(l.strip() and not l.lstrip().startswith("#") for l in kept)
                   else "\n".join(kept).rstrip() + "\n") + block
    target.write_text(updated)
    return target


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--profile", default="web")
    parser.add_argument("--agy-mode", default="review", choices=("review", "accept-edits", "full"))
    parser.add_argument("--print", action="store_true", help="print the block instead of writing it")
    args = parser.parse_args()
    presets = uses_presets(args.profile)
    block = transform(standard_preset().read_text(), args.agy_mode) if presets else root_block(args.agy_mode)
    if args.print:
        print(block)
        return 0
    what = "preset 'fleet'" if presets else "root delegate tools"
    print(f"dsh-fleet-preset: wrote {what} to {install(args.profile, block)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
